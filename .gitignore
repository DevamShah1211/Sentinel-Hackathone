# Captured plate crops. The labels are committed (they are the dataset), the
# images are not: they are large, they are regenerable, and real crops would
# contain vehicles belonging to identifiable people.
backend/data/plate_dataset/images/

# Video working folder: the edit assets are hundreds of MB and GitHub rejects
# blobs over 100 MB. The canonical evidence images stay tracked in DOCS/evidence.
DOCS/evidence/Sentinel Video/
DOCS/evidence/*.zip
